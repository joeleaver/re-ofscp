// re-ofscp database schema (rhypedb SDL). Deployed by jkbase via `[database]`.
// Starter types only — the build grows this to the full OFSCP data model.

// An OFSCP account on this provider (spec §5.1). Admins are a separate
// identity system (CLAUDE.md) and are not stored here. Accounts are created
// by admins or by invitation only (docs/decisions/0004).
type User {
    handle: String @unique
    display_name: String
    // Argon2id PHC string (§4.1.4).
    password_hash: String
    // "active" or "disabled". A disabled account cannot log in and its keys
    // do not verify.
    status: String
    created_at: DateTime @indexed
    // Public profile (§5.1.1, §6.3; docs/decisions/0009). Added after the
    // first deploy: accounts created before then lack these fields, which
    // read back as absent and mean "none" (`profile_updated_at` falls back
    // to `created_at`). The empty string also means "none" for `avatar` and
    // `bio`.
    avatar: String
    bio: String
    // The profile's metadata list (§5.4), as a JSON array.
    profile_metadata: String
    profile_updated_at: DateTime
}

// A device key (§4.3.2), owned by the account with `handle`. Keys are found
// by (handle, key_id) with one indexed lookup. (No relation field: rhypedb at
// the pinned commit cannot link an object inside `create`, and linking
// afterwards would be a second, non-atomic statement. Accounts are disabled,
// not deleted; deleting one later removes its keys by handle.)
type DeviceKey {
    key_id: String @unique
    handle: String @indexed
    public_key: String
    algorithm: String
    device_name: String
    created_at: DateTime
    revoked: Bool
    revoked_at: DateTime
}

// An account invite (§4.1.1, lost-conn/ofscp#18): single-use, time-limited,
// optionally pinned to a handle. Only the token's SHA-256 is stored.
// `used_at` and `used_by` describe the use only while `used` is true (a
// registration that fails after claiming the invite releases it again).
type RegistrationInvite {
    token_hash: String @unique
    // The pinned handle, absent when the invite is for any handle.
    handle: String
    // The admin who issued it.
    created_by: String
    created_at: DateTime
    expires_at: DateTime @indexed
    used: Bool
    used_at: DateTime
    used_by: String
}

// The persistent replay ledger (spec §4.5 "Restarts"; docs/decisions/0001).
// One row per accepted nonce, written before the request is accepted and
// purged once expired. `key` is SHA-256 over (signer kind, key id, nonce).
type ReplayNonce {
    key: String @unique
    kind: String
    signer: String
    domain: String
    key_id: String
    nonce: String
    signed_at: DateTime
    expires_at: DateTime @indexed
}

// The replay store's clock, persisted when the ledger is purged, so a nonce
// purged as expired stays expired after a restart even if the wall clock had
// stepped forward and was corrected (docs/decisions/0001). One row, "replay".
type ReplayClock {
    name: String @unique
    high_water: DateTime
}

// An admin of this provider (docs/decisions/0005). Admins are a separate
// identity system from `User`: they are not OFSCP actors, are never
// federated and never sign OFSCP requests.
type Admin {
    username: String @unique
    // Argon2id PHC string.
    password_hash: String
    // "owner", "operator" or "read_only".
    role: String
    // "active" or "disabled". Disabling is final.
    status: String
    // The TOTP secret, sealed with ADMIN_SECRET_KEY (XChaCha20-Poly1305,
    // bound to the username). Empty until enrollment is confirmed.
    totp_secret: String
    // A secret awaiting confirmation (sealed likewise), or empty.
    totp_pending: String
    // The last accepted TOTP time step; a code is accepted only for a later
    // step, so each code works once.
    totp_last_step: i64
    // Set when another admin chose the password.
    password_change_required: Bool
    // Bumped whenever the admin's credentials change (TOTP confirmed or
    // reset, password changed). Each session records the value it was
    // opened under and ends once it differs.
    credential_epoch: i64
    // The admin who created this one, or "setup".
    created_by: String
    created_at: DateTime
}

// A signed-in admin's session. Only the token's SHA-256 is stored.
type AdminSession {
    token_hash: String @unique
    username: String @indexed
    // The admin's credential_epoch when the session was opened.
    credential_epoch: i64
    created_at: DateTime
    last_seen_at: DateTime
    // Absolute end, whatever the activity.
    expires_at: DateTime @indexed
}

// The admin audit log: one entry per admin action, written before the
// action runs (outcome "pending") and completed after it.
type AdminAudit {
    at: DateTime @indexed
    admin: String @indexed
    action: String
    target: String
    outcome: String
    source: String
    detail: String
}

// The federation policy's mode (spec §8 Authorization,
// docs/decisions/0008). One row, "federation"; absent means "open".
type FederationSetting {
    name: String @unique
    // "open", "allowlist" or "denylist".
    mode: String
    // The admin who last set it.
    updated_by: String
    updated_at: DateTime
}

// One rule of the federation policy. Both lists are kept whatever the
// mode; the mode says which is in force. `rule_id` is derived from
// (list, scope, value), so the same rule cannot be stored twice.
type FederationRule {
    rule_id: String @unique
    // "allow" or "deny".
    list: String
    // "authority" (exactly that host[:port]) or "domain" (that name and
    // every name under it, any port).
    scope: String
    // The canonical authority or domain.
    value: String
    note: String
    // The admin who added it.
    created_by: String
    created_at: DateTime
}

// A user's privacy settings (§6.1, §6.6; docs/decisions/0009). One row per
// account, created on its first `PUT /api/me/privacy`; an account without
// one has the defaults. The lists hold canonical actors (§2.2) as JSON
// arrays of strings.
type PrivacySettings {
    handle: String @unique
    // §6.1 visibility values: "public", "authenticated", "sharedGroups",
    // "contacts" or "nobody".
    presence_visibility: String
    profile_visibility: String
    membership_visibility: String
    allow_list: String
    deny_list: String
    // The settings' metadata list (§5.4), as a JSON array.
    metadata: String
    updated_at: DateTime
}

// A user's stored presence (§6.4, §7.5). One row per account, created on
// its first `PUT /api/me/presence`. `availability` is the explicit value
// ("online", "away" or "dnd"); what viewers see is derived from it and
// connection liveness. `status` is empty when unset; `last_seen` is set when
// the user's last connection ends.
type Presence {
    handle: String @unique
    availability: String
    status: String
    // The presence metadata list (§5.4), as a JSON array.
    metadata: String
    last_seen: DateTime
    updated_at: DateTime
}
