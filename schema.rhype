// re-ofscp database schema (rhypedb SDL). Deployed by jkbase via `[database]`.
// Starter types only — the build grows this to the full OFSCP data model.

// An OFSCP account on this provider (spec §5.1). Admins are a separate
// identity system (CLAUDE.md) and are not stored here. Accounts are created
// by admins or by invitation only (docs/decisions/0004).
type User {
    handle: String @unique
    display_name: String
    // Argon2id PHC string (§4.1.4).
    password_hash: String
    // "active" or "disabled". A disabled account cannot log in and its keys
    // do not verify.
    status: String
    created_at: DateTime @indexed
}

// A device key (§4.3.2), owned by the account with `handle`. Keys are found
// by (handle, key_id) with one indexed lookup. (No relation field: rhypedb at
// the pinned commit cannot link an object inside `create`, and linking
// afterwards would be a second, non-atomic statement. Accounts are disabled,
// not deleted; deleting one later removes its keys by handle.)
type DeviceKey {
    key_id: String @unique
    handle: String @indexed
    public_key: String
    algorithm: String
    device_name: String
    created_at: DateTime
    revoked: Bool
    revoked_at: DateTime
}

// The persistent replay ledger (spec §4.5 "Restarts"; docs/decisions/0001).
// One row per accepted nonce, written before the request is accepted and
// purged once expired. `key` is SHA-256 over (signer kind, key id, nonce).
type ReplayNonce {
    key: String @unique
    kind: String
    signer: String
    domain: String
    key_id: String
    nonce: String
    signed_at: DateTime
    expires_at: DateTime @indexed
}

// The replay store's clock, persisted when the ledger is purged, so a nonce
// purged as expired stays expired after a restart even if the wall clock had
// stepped forward and was corrected (docs/decisions/0001). One row, "replay".
type ReplayClock {
    name: String @unique
    high_water: DateTime
}
