# Local development values for scripts/dev-admin.sh. NOT secrets: these are
# throwaway test values for a provider on http://localhost only. Never use
# them, or ADMIN_LOOPBACK_HTTP, anywhere else.

# The console (trunk serve) and the provider, as the browser sees them.
DEV_UI_PORT=8090
DEV_SERVER_PORT=8091
DEV_RHYPEDB_HTTP_PORT=8092
DEV_RHYPEDB_TCP_PORT=8093

# The provider's configuration (crates/re-ofscp-server/src/config.rs).
DOMAIN=localhost:8090
ADMIN_LOOPBACK_HTTP=true
ADMIN_SECRET_KEY=UK98nvUyMMnINao8yaWKlW1QEPKtlnU1owZJxjHFzaw=
ADMIN_SETUP_TOKEN=dev-setup-token-ccf64c5c679253fa86233b6a4ad8cf90

# The first owner `scripts/dev-admin.sh setup` creates. Sign in with these,
# then enroll TOTP from the secret the console shows.
DEV_ADMIN_USERNAME=dev-owner
DEV_ADMIN_PASSWORD=dev-owner-password-1

# A second admin, created from the console by the owner to check the
# restricted flow (initial password, then their own, then TOTP enrollment).
DEV_SECOND_ADMIN_USERNAME=dev-operator
DEV_SECOND_ADMIN_INITIAL_PASSWORD=dev-operator-initial-1
DEV_SECOND_ADMIN_PASSWORD=dev-operator-password-1
